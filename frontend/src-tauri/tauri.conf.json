{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ASCII Motion",
  "version": "0.1.0",
  "identifier": "dev.asciimotion.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev:tauri",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "ASCII Motion",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "externalBin": [
      "binaries/ascii-motion-api"
    ],
    "shortDescription": "Convierte imágenes en arte ASCII",
    "longDescription": "Aplicación de escritorio para convertir imágenes en arte ASCII con procesamiento local.",
    "category": "GraphicsAndDesign"
  }
}
